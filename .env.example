# Contoh variabel environment untuk uts-devops-tesing.
# Salin file ini menjadi .env lalu ganti nilai "ganti_...".
# File .env berisi password asli dan TIDAK BOLEH di-commit.

# ===== Container database (MySQL 8.0) =====
MYSQL_ROOT_PASSWORD=ganti_password_root
MYSQL_DATABASE=crud_db
MYSQL_USER=crud_user
MYSQL_PASSWORD=ganti_password_aplikasi

# ===== Container backend (Node.js + Express) =====
# DATABASE_PASSWORD harus sama dengan MYSQL_PASSWORD di atas.
DATABASE_HOST=database
DATABASE_PORT=3306
DATABASE_USER=crud_user
DATABASE_PASSWORD=ganti_password_aplikasi
DATABASE_NAME=crud_db
PORT=5001